Vcov       = TRUE,
verbose    = TRUE       # prints param vector each EM iteration
)
fit
# ----------------------------------------------------------------------
# 0.  ABSOLUTELY FIRST: make sure the JEL package on disk is the one
#     that's loaded.  If you `library(JEL)`'d before the latest install,
#     the new R-side patches (e.g. pd_safe) are NOT in memory.
# ----------------------------------------------------------------------
if ("package:JEL" %in% search()) detach("package:JEL", unload = TRUE)
if ("JEL" %in% loadedNamespaces()) unloadNamespace("JEL")
library("dplyr")
library("splines")
library("survival")
library("ggplot2")
library(JEL)
# Sanity check: the patched RefinedfastEM_LLA_tv should contain pd_safe().
stopifnot(any(grepl("pd_safe",
deparse(JEL:::RefinedfastEM_LLA_tv))))
cat("[ok] pd_safe() is present inside JEL:::RefinedfastEM_LLA_tv -- new code is loaded.\n")
# ----------------------------------------------------------------------
# 1.  Paths + data
# ----------------------------------------------------------------------
if (Sys.info()[["sysname"]] == "Linux") {
pbc_dir <- "/mnt/c/Users/kevin/Dropbox/Projects/Dynamic_prediction/LLAJEL/realdata/pbc"
} else {
pbc_dir <- "~/Library/CloudStorage/Dropbox/Projects/Dynamic_prediction/LLAJEL/realdata/pbc"
}
plot_path <- file.path(pbc_dir, "figure")
dir.create(plot_path, showWarnings = FALSE, recursive = TRUE)
dat <- JM::pbc2
train_data <- dat
train_data$Y.1 <- log(train_data$serBilir)
train_data$Y.2 <- train_data$albumin
train_data$Y.3 <- (0.1 * train_data$prothrombin)^(-4)
var_list_pbc <- list(id = "id", time = "year",
EvTime = "years", event = "status2")
# ----------------------------------------------------------------------
# 2.  PICK ONE CELL TO DEBUG  (edit these to try other cells)
# ----------------------------------------------------------------------
s_dbg   <- 5            # landmark
nam_dbg <- "Y2"         # used in filename
y_col   <- "Y.2"        # actual column in train_data
df_dbg  <- 3
deg_dbg <- 1
h       <- 4            # bandwidth
cat(sprintf("\n=== DEBUG cell: s=%g, %s (=%s), df=%d, deg=%d, h=%g ===\n",
s_dbg, nam_dbg, y_col, df_dbg, deg_dbg, h))
# ----------------------------------------------------------------------
# 3.  prep landmarked dataset
# ----------------------------------------------------------------------
train_dataset <- JEL_dat(
data      = train_data,
land_time = s_dbg,
var_list  = var_list_pbc
)
str(train_dataset, max.level = 1)
# ----------------------------------------------------------------------
# 4.  spline spec
# ----------------------------------------------------------------------
Bs_univ <- list(list(df = df_dbg, degree = deg_dbg,
knots = NULL, Bknots = NULL))
# ----------------------------------------------------------------------
# 5.  CALL THE FIT.  When this errors, drop into recover() so you can
#     poke at frames manually:  options(error = recover)
# ----------------------------------------------------------------------
old_err <- getOption("error")
options(error = recover)   # comment this out if you don't want recover()
fit <- LLAJEL(
train_dataset,
y_vars     = y_col,
s          = s_dbg,
h          = h,
base_terms = c("drug"),
Bs         = Bs_univ,
ker        = "gaussian",
max.iter   = 500,
Vcov       = TRUE,
verbose    = TRUE       # prints param vector each EM iteration
)
# bLLA / Bsigma는 surv.init에 안 잡혀 있고 RefinedfastEM_LLA_tv 인자로는 직접 안 들어감.
# 대신 D는 init에서 Bsigma로부터 만들어진 것이니, D 자체에 NaN/Inf 있는지부터:
cat("any non-finite in D? ", any(!is.finite(D)), "\n")
print(D)
# =============================================================================
# Simulation_JELcheck_multi.R
#
# AUC/PE comparison of JEL / LM / TS / TRUE under K=3 multivariate DGP
# (no f_k, no W, landmark-frozen Weibull, orthogonal tangent random effects).
#
#   DGP:   Y_{ik}(t) = alpha_{ik,0} + alpha_{ik,1}(t - s) + eps_k,  k=1,2,3
#          (b_{ik,0}(s), b_{ik,1}(s)) ~ N(0,  D_b_k),  D_b_k = diag(2.50, 0.25)
#          block-diagonal across processes
#          Weibull(shape = 1.5, scale = 5)
#          eta_k = (-0.5, 0.25) for each k=1,2,3,  phi = 0
#          t in [0.5, 14], n = 1000, ntms = 30
#
#   Landmark s = 5,  tau in {2, 4},  bandwidth h = 2
#
# JM is skipped (K=3 multivariate JM needs JMbayes2).
# =============================================================================
library(survival); library(dplyr)
n_list        <- c(1000)
# sigma_y_list  <- c(0.1, 1)
sigma_y_list  <- c(1)
s_fixed       <- 5
tau_list      <- c(2, 4)
n_simul       <- 10
ntms          <- 30
h_LLAJEL      <- 2
ker_LLAJEL    <- "epanechnikov"
K_proc <- 3
block <- matrix(c(2.50, 0,
0,    0.25), nrow = 2, byrow = TRUE)
D_b_dgp <- matrix(0, 2 * K_proc, 2 * K_proc)
for (k in seq_len(K_proc)) {
idx <- (2 * (k - 1) + 1):(2 * k)
D_b_dgp[idx, idx] <- block
}
c_b_dgp   <- rep(0, 2 * K_proc)
eta_dgp   <- rep(c(-0.5, 0.25), K_proc)
phi_dgp   <- c(0, 0)
weibull_shape <- 1.5
weibull_scale <- 5
min_time      <- 0.5
max_time      <- 14
max_horizon_s <- max_time - s_fixed
f_dir   <- "~/Library/CloudStorage/Dropbox/Projects/Dynamic_prediction/LLAJEL/simulation/Simulation_JEL_multi/"
out_dir <- file.path(f_dir, "result", "AUCPE")
dir.create(file.path(out_dir, "AUC"),       showWarnings = FALSE, recursive = TRUE)
dir.create(file.path(out_dir, "PE"),        showWarnings = FALSE, recursive = TRUE)
dir.create(file.path(out_dir, "pred_surv"), showWarnings = FALSE, recursive = TRUE)
dir.create(file.path(out_dir, "Data"),      showWarnings = FALSE, recursive = TRUE)
source(file.path(f_dir, "joint.sim.dat.multi.R"))
source(file.path(f_dir, "data_generation_JELcheck_multi.R"))
source(file.path(f_dir, "model_compare_run_predict_multi.R"))
jel_eval_dir <- "/Users/jinwoocho/Library/CloudStorage/Dropbox/Projects/Dynamic_prediction/JEL/R_function/JEL"
source(file.path(jel_eval_dir, "AUCCV.R"))
source(file.path(jel_eval_dir, "PECV.R"))
# Methods (JM via joineRML::mjoint for K-variate)
n_models <- list(JM = 1, LM = 2, TS = 2, Ttrue = 1, LLAJEL = 1)
method_n <- c("JM", "LM", "TS", "TRUE", "LLAJEL")
for (nn in n_list) {
for (sigsig in sigma_y_list) {
for (tautau in tau_list) {
data_list   <- list(); result_list <- list()
auc_list    <- list(); pe_list     <- list()
for (n_ss in seq_len(n_simul)) {
ss <- n_ss + 1234
message(sprintf("\n[sigma=%g  tau=%g]  Sim %d / %d   seed = %d",
sigsig, tautau, n_ss, n_simul, ss))
dat <- data_generation_JELcheck_multi(
n = nn, K = K_proc, s = s_fixed, h = h_LLAJEL, ntms = ntms,
min_time = min_time, max_time = max_time,
sigma.y = rep(sigsig, K_proc),
eta = eta_dgp, c_b = c_b_dgp, D_b = D_b_dgp,
weibull_shape = weibull_shape, weibull_scale = weibull_scale,
max_horizon = max_horizon_s,
seed = ss, regular = TRUE
)
truth <- attr(dat, "truth")
data_list[[n_ss]] <- dat
st <- Sys.time()
test_model <- tryCatch(
model_compare_run_predict_multi(
dat = dat, V = 5, tau = tautau, landmarks = s_fixed,
K_proc = K_proc,
h_LLAJEL = h_LLAJEL, ker_LLAJEL = ker_LLAJEL, truth = truth),
error = function(e) {
message("  model_compare error: ", conditionMessage(e)); NULL
})
ed <- Sys.time()
message(sprintf("  run time: %.2f min",
as.numeric(difftime(ed, st, units = "mins"))))
if (is.null(test_model)) next
dat_eval <- dat %>% dplyr::rename(Time = survtime, event = status)
# AUCCV/PECV expects a single y column.  For multivariate, use Y.1 as
# the "anchor" — the actual prediction is the multivariate output that
# AUCCV reads from test_model$LLAJEL etc., the y column is just a
# placeholder for the helper's bookkeeping.
dat_eval$y <- dat_eval$Y.1
KM_est <- survfit(Surv(Time, event) ~ 1, data = dat_eval)
auc_list[[n_ss]] <- tryCatch(
AUCCV(test_model, test = dat_eval,
landmarks = s_fixed, tau = tautau, KM_est = KM_est,
method_n, n_models,
var_list = list(id = "id", time = "time",
EvTime = "Time", event = "event")),
error = function(e) { message("  AUCCV error: ", conditionMessage(e)); NULL })
pe_list[[n_ss]] <- tryCatch(
PECV(test_model, test = dat_eval,
landmarks = s_fixed, tau = tautau, KM_est = KM_est,
method_n, n_models,
var_list = list(id = "id", time = "time",
EvTime = "Time", event = "event")),
error = function(e) { message("  PECV error: ", conditionMessage(e)); NULL })
result_list[[n_ss]] <- test_model
}
tag <- paste0("multi_sigmay_", sigsig,
"_n_", nn, "_s_", s_fixed, "_tau_", tautau,
"_ni_", ntms, "_h_", h_LLAJEL)
save(data_list,   file = file.path(out_dir, "Data",      paste0("Data_",     tag, ".RData")))
save(result_list, file = file.path(out_dir, "pred_surv", paste0("PredSurv_", tag, ".RData")))
save(auc_list,    file = file.path(out_dir, "AUC",       paste0("AUC_",      tag, ".RData")))
save(pe_list,     file = file.path(out_dir, "PE",        paste0("PE_",       tag, ".RData")))
message(sprintf("Saved AUC/PE for sigma=%g, tau=%g", sigsig, tautau))
}
}
}
source("LLAJEL/R_function/LLAJEL/test_press_leverage.R")
source("LLAJEL/R_function/LLAJEL/test_press_leverage.R")
# =============================================================================
# test_press_leverage.R
#
# Numerical check that the PRESS leverage identity used in
# `select_h_longitudinal()` matches brute-force leave-one-observation-out
# BLUP refitting, to machine precision.
#
# For one synthetic subject i with multi-process Z_i (block-diagonal),
# Y_i, kernel weights w_i, and population parameters (c, D, var.e),
# we check:
#
#     resid_LOO_jk  ==  (Y_jk - z_jk^T mu_i) / (1 - h_jk)
#
# against the brute-force solution obtained by deleting (j, k), refitting
# Lambda_i and mu_i from scratch, then predicting at (j, k).
#
# Run:
#     source("LLAJEL/R_function/LLAJEL/test_press_leverage.R")
#     test_press_leverage()
# =============================================================================
test_press_leverage <- function(seed = 1L,
m_per_proc = c(7, 5, 8),
tol = 1e-10,
verbose = TRUE) {
set.seed(seed)
nK <- length(m_per_proc)
p  <- 2L * nK
# ---- 1. Synthetic subject -------------------------------------------------
# Z_k = (1, t_k - s) for randomly placed times; w_k = uniform positive
Zi_blocks <- lapply(seq_len(nK), function(k) {
tk <- sort(runif(m_per_proc[k], -1.5, 1.5))   # t - s in [-1.5, 1.5]
cbind(1, tk)
})
Zi <- as.matrix(Matrix::bdiag(Zi_blocks))
m_ik     <- vapply(Zi_blocks, nrow, integer(1))
proc_idx <- rep(seq_len(nK), times = m_ik)
wi <- runif(sum(m_ik), 0.2, 1.0)
# Population params
D    <- diag(c(2.5, 0.25), p, p)
# add small cross-process correlation to ensure non-block-diagonal exercise
for (k1 in seq_len(nK - 1L)) {
for (k2 in (k1 + 1L):nK) {
i1 <- 2L * (k1 - 1L) + 1L
j1 <- 2L * (k2 - 1L) + 1L
D[i1, j1] <- D[j1, i1] <- 0.4
}
}
vare <- runif(nK, 0.05, 0.5)
cvec <- runif(p, -0.5, 0.5)
# Synthetic outcome
b_true <- as.numeric(MASS::mvrnorm(1, mu = cvec, Sigma = D))
sig_rep <- vare[proc_idx]
Yi <- as.numeric(Zi %*% b_true) + sqrt(sig_rep) * rnorm(sum(m_ik))
# ---- 2. PRESS leverage path -----------------------------------------------
Wvec   <- wi / sig_rep
D_inv  <- solve(D)
Lambda <- D_inv + crossprod(Zi, Zi * Wvec)
LamInv <- solve(Lambda)
resid_c <- Yi - as.numeric(Zi %*% cvec)
score   <- crossprod(Zi, Wvec * resid_c)
mu      <- cvec + as.numeric(LamInv %*% score)
yhat       <- as.numeric(Zi %*% mu)
resid_full <- Yi - yhat
H_diag     <- Wvec * rowSums((Zi %*% LamInv) * Zi)
resid_press <- resid_full / (1 - H_diag)
# ---- 3. Brute-force LOO ---------------------------------------------------
N <- length(Yi)
resid_brute <- numeric(N)
for (r in seq_len(N)) {
keep <- setdiff(seq_len(N), r)
Z_r  <- Zi[keep, , drop = FALSE]
Y_r  <- Yi[keep]
Wv_r <- Wvec[keep]
Lam_r <- D_inv + crossprod(Z_r, Z_r * Wv_r)
LamInv_r <- solve(Lam_r)
rc_r   <- Y_r - as.numeric(Z_r %*% cvec)
score_r <- crossprod(Z_r, Wv_r * rc_r)
mu_r    <- cvec + as.numeric(LamInv_r %*% score_r)
yhat_r <- as.numeric(Zi[r, , drop = FALSE] %*% mu_r)
resid_brute[r] <- Yi[r] - yhat_r
}
# ---- 4. Compare -----------------------------------------------------------
abs_diff <- abs(resid_press - resid_brute)
max_diff <- max(abs_diff)
if (verbose) {
cat(sprintf("PRESS leverage vs brute-force LOO (N = %d obs)\n", N))
cat(sprintf("  max |diff| = %.2e   (tol = %.0e)\n", max_diff, tol))
cat(sprintf("  resid (PRESS)  head : %s\n",
paste(sprintf("%.5f", head(resid_press, 4)), collapse = "  ")))
cat(sprintf("  resid (brute)  head : %s\n",
paste(sprintf("%.5f", head(resid_brute, 4)), collapse = "  ")))
}
pass <- max_diff < tol
if (verbose) cat(if (pass) "  [PASS]\n" else "  [FAIL]\n")
invisible(list(
pass        = pass,
max_diff    = max_diff,
resid_press = resid_press,
resid_brute = resid_brute
))
}
# =============================================================================
# select_h_longitudinal
#
# Cross-validated bandwidth selection for LLAJEL based on longitudinal
# leave-one-observation-out (LOO) prediction error, evaluated by the PRESS
# leverage identity (no obs-by-obs refit needed).
#
# Pipeline (option B; see report_0522 h-selection note):
#   - Baseline EM (JEL::LLAJEL) is run ONCE at `baseline_h` (default median
#     of h_grid).  D and var.e from this fit are reused for every candidate h.
#   - For each h in h_grid:
#       * JEL:::prep_LLA_landmark(h) refreshes kernel weights, per-subject
#         Z / Y / w arrays, and the centering c (cLLA).
#       * For each subject i, build precision
#             Lambda_i = D^{-1} + Z_i^T R_i^{-1} Z_i ,
#             R_i = diag(sigma_k^2 / w_{ij}),
#         then BLUP mean
#             mu_i = c + Lambda_i^{-1} Z_i^T R_i^{-1} (Y_i - Z_i c).
#       * PRESS leverage identity gives LOO residual without refitting:
#             e_{LOO,jk} = (Y_{ijk} - z_jk^T mu_i) / (1 - h_jk),
#             h_jk = (w_{ij} / sigma_k^2) * z_jk^T Lambda_i^{-1} z_jk.
#       * Squared LOO residuals are aggregated only over obs with
#             |t_{ij} - s0| <= W ,
#         where W defaults to max(h_grid) (Epanechnikov: exact kernel-support
#         union) or 1.5 * max(h_grid) for Gaussian.
#
# Returns:
#   list with components:
#     h_grid          numeric vector  candidate bandwidths
#     cv_per_process  matrix[|h_grid| x nK]  per-process MSE
#     cv_shared       numeric  scale-normalised criterion (sum_k MSE_k / var.e_k)
#     h_per_process   numeric  per-process minimisers (length nK)
#     h_shared        numeric  single minimiser of cv_shared
#     n_in_W_per_proc matrix[|h_grid| x nK]  obs count inside window per h
#     W               numeric  window half-width used
#     ker             character  kernel used
#     baseline_h      numeric  bandwidth at which EM was run
#     baseline_fit    LLAJEL fit object  reused for D and var.e
# =============================================================================
select_h_longitudinal <- function(
LMM_dat,
Surv_dat,
y_vars,
s0,
h_grid,
ker            = c("epanechnikov", "gaussian"),
W              = NULL,
var_list       = list(id = "id", time = "time"),
baseline_h     = NULL,
fit            = NULL,
train_dataset  = NULL,
base_terms     = character(0),
Bs             = NULL,
gh.nodes       = 7,
max.iter       = 1000,
tol            = 0.001,
verbose        = FALSE
) {
ker <- match.arg(ker)
stopifnot(length(h_grid) >= 2, all(h_grid > 0))
# ---- 1. Window W ----------------------------------------------------------
if (is.null(W)) {
W <- if (ker == "epanechnikov") max(h_grid) else 1.5 * max(h_grid)
}
# ---- 2. Baseline EM fit (one-time) ----------------------------------------
if (is.null(fit)) {
if (is.null(train_dataset))
stop("`select_h_longitudinal`: provide either `fit` (pre-fitted at ",
"baseline_h) or `train_dataset` to run a one-shot baseline EM.")
if (is.null(baseline_h)) baseline_h <- stats::median(h_grid)
if (verbose) message(sprintf("[select_h] baseline EM at h = %.3f ...",
baseline_h))
fit <- JEL::LLAJEL(
train_dataset = train_dataset,
y_vars        = y_vars,
s             = s0,
h             = baseline_h,
base_terms    = base_terms,
ker           = ker,
Bs            = Bs,
gh.nodes      = gh.nodes,
max.iter      = max.iter,
tol           = tol,
Vcov          = FALSE,
verbose       = FALSE
)
} else if (is.null(baseline_h)) {
# If user supplied a pre-fit, try to recover the h it was fit at.
baseline_h <- tryCatch(fit$h, error = function(e) NA_real_)
if (is.null(baseline_h)) baseline_h <- NA_real_
}
D_fit <- fit$coefficients$D
vare  <- fit$coefficients$var.e
nK    <- length(y_vars)
stopifnot(nrow(D_fit) == 2L * nK, length(vare) == nK)
D_inv <- tryCatch(
solve(D_fit),
error = function(e) chol2inv(chol(D_fit + diag(1e-8, 2L * nK)))
)
# ---- 3. Per-h LSCV via PRESS leverage -------------------------------------
n_h <- length(h_grid)
cv_per_process <- matrix(NA_real_, n_h, nK)
n_in_W         <- matrix(0L,       n_h, nK)
for (i_h in seq_along(h_grid)) {
h_cand <- h_grid[i_h]
prep <- JEL:::prep_LLA_landmark(
LMM_dat  = LMM_dat,
Surv_dat = Surv_dat,
y_vars   = y_vars,
s0       = s0,
h        = h_cand,
ker      = ker,
var_list = var_list
)
cvec <- as.numeric(unlist(prep$cLLA))   # length 2 * nK, ordered (b0,b1) per k
nsub <- length(prep$ni[[1]])
Z_st <- lapply(seq_len(nK), function(k) {
split(prep$Z[[k]], prep$ID[[k]]) |>
lapply(function(v) matrix(v, ncol = ncol(prep$Z[[k]])))
})
Y_st <- lapply(seq_len(nK), function(k) split(prep$Y[[k]], prep$ID[[k]]))
W_st <- lapply(seq_len(nK), function(k) split(prep$W_ker[[k]], prep$ID[[k]]))
sse_per_proc <- numeric(nK)
n_per_proc   <- integer(nK)
for (i in seq_len(nsub)) {
Zi_blocks <- lapply(seq_len(nK), function(k) Z_st[[k]][[i]])
m_ik      <- vapply(Zi_blocks, NROW, integer(1))
if (sum(m_ik) == 0L) next
Zi <- as.matrix(Matrix::bdiag(Zi_blocks))
Yi <- unlist(lapply(seq_len(nK), function(k) Y_st[[k]][[i]]))
wi <- unlist(lapply(seq_len(nK), function(k) W_st[[k]][[i]]))
proc_idx <- rep(seq_len(nK), times = m_ik)
sig_rep  <- vare[proc_idx]
Wvec    <- wi / sig_rep                  # diag(R_i^{-1})
ZtWZ    <- crossprod(Zi, Zi * Wvec)
Lambda  <- D_inv + ZtWZ
LamInv  <- tryCatch(
solve(Lambda),
error = function(e)
chol2inv(chol(Lambda + diag(1e-8, nrow(Lambda))))
)
resid_c <- Yi - as.numeric(Zi %*% cvec)
score   <- crossprod(Zi, Wvec * resid_c)
mu      <- cvec + as.numeric(LamInv %*% score)
yhat       <- as.numeric(Zi %*% mu)
resid_full <- Yi - yhat
H_diag     <- Wvec * rowSums((Zi %*% LamInv) * Zi)
resid_loo  <- resid_full / pmax(1 - H_diag, 1e-8)
# Window mask: |t - s0| = |Z[, 2]| since Z = (1, t - s0)
tcol <- unlist(lapply(Zi_blocks, function(zb) zb[, 2]))
mask <- abs(tcol) <= W
for (k in seq_len(nK)) {
idx_k <- which(proc_idx == k & mask)
if (length(idx_k) > 0L) {
sse_per_proc[k] <- sse_per_proc[k] + sum(resid_loo[idx_k]^2)
n_per_proc[k]   <- n_per_proc[k]   + length(idx_k)
}
}
}
n_per_safe <- pmax(n_per_proc, 1L)
cv_per_process[i_h, ] <- sse_per_proc / n_per_safe
n_in_W[i_h, ]         <- n_per_proc
if (verbose) {
cat(sprintf(
"[select_h] h = %.3f   CV_k = %s   (n_in_W = %s)\n",
h_cand,
paste(sprintf("%.4g", cv_per_process[i_h, ]), collapse = ", "),
paste(n_per_proc, collapse = ", ")
))
}
}
# ---- 4. Aggregate criteria ------------------------------------------------
cv_shared      <- as.numeric(cv_per_process %*% (1 / vare))
h_shared       <- h_grid[which.min(cv_shared)]
h_per_process  <- h_grid[apply(cv_per_process, 2, which.min)]
list(
h_grid          = h_grid,
cv_per_process  = cv_per_process,
cv_shared       = cv_shared,
h_per_process   = h_per_process,
h_shared        = h_shared,
n_in_W_per_proc = n_in_W,
W               = W,
ker             = ker,
baseline_h      = baseline_h,
baseline_fit    = fit
)
}
library(JEL)
source("LLAJEL/R_function/LLAJEL/select_h_longitudinal.R")
library(JEL)
test_press_leverage()
